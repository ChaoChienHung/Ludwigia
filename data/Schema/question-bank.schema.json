{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludwigia.local/question-bank.schema.json",
  "title": "Ludwigia Question Bank v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "lang",
          "question_type",
          "prompt",
          "choices",
          "answer",
          "difficulty",
          "question_focus",
          "tag_concepts",
          "review_status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "lang": {
            "type": "string"
          },
          "question_type": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "response": {
                  "type": "string"
                }
              }
            }
          },
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "minLength": 1
          },
          "question_focus": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "tag_concepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_status": {
            "type": "string",
            "minLength": 1
          },
          "last_review_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
